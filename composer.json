{
    "name": "sikofitt/generate-mac",
    "description": "Generates dummy mac addresses",
    "keywords": ["mac", "mac address", "random", "generate","media access control"],
    "type": "library",
    "require": {
        "php": ">=8.2",
        "ext-json": "*"
    },
    "autoload": {
      "psr-4": {
        "Sikofitt\\GenerateMac\\": "src/GenerateMac"
      }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/console": "^7.3"
    },
    "autoload-dev": {
      "psr-4": {
        "Sikofitt\\GenerateMac\\Tests\\": "tests/"
      }
    },
    "extra": {
      "branch-alias": {
        "dev-trunk": "2.1.x-dev"
      }
    },
    "config": {
      "sort-packages": true
    },
    "suggest": {
      "symfony/console": "To use the generate-mac command."
    },
    "bin": ["bin/generate-mac"],
    "license": "GPL-3.0-only",

  "authors": [
        {
            "name": "sikofitt",
            "email": "sikofitt@gmail.com"
        }
    ]
}
